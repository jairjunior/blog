<!doctype html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Alterar Senha | jjOutOfBounds</title>
	<meta name="description" content="Redefinir sua senha cadastrada no site jjOutOfBounds.">

	<!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/reset-password.css">

	<!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
	<header class="title-box">
		<h1 class="blog-title">
			<a href="/" aria-label="Página inicial do blog">jjOutOfBounds</a>
		</h1>
	</header>
	
	<main>
		<% if (success) { %>
			<div class="main-box card-hover-effect">
				<h2>Alterar Senha</h2>
				<form id="resetPasswordForm">
					<input id="token" name="token" type="hidden" value="<%= token %>">

					<div class="form-group">
						<label for="password">Nova Senha <span class="required" aria-hidden="true">*</span></label>
						<input 
							id="password" 
							name="password" 
							type="password" 
							autocomplete="new-password" 
							aria-describedby="passwordRequirements" 
							required
						>
					</div>

					<div class="form-group">
						<label for="confirmPassword">Confirmar Nova Senha <span class="required" aria-hidden="true">*</span></label>
						<input 
							id="confirmPassword" 
							name="confirmPassword" 
							type="password" 
							autocomplete="new-password" 
							required
						>
					</div>

					<small id="passwordRequirements" class="description-text">
						A senha deve ter no mínimo 8 caracteres, incluindo uma letra maiúscula, uma minúscula, um número e um caractere especial (ex: @, #, $, !).
					</small>

					<p id="feedbackMessage" class="feedback-message" role="alert" aria-live="assertive"></p>
					
					<button type="submit">Salvar Nova Senha</button>
				</form>
				<p class="back-to-login">
                	<a href="/login">⬅️ Voltar para o Log in</a>
            	</p>
				<span class="text-center or-then">ou então</span>
				<p class="back-to-homepage">
					<a href="/">🏠 Página Principal</a>
				</p>
			</div>
		<% } else { %>
			<div class="main-box card-hover-effect">
				<p class="feedback-message error text-bigger text-center" role="alert" aria-live="assertive">
					<%= messagePt %>
				</p>
				<p class="back-to-login margin-top-bigger">
                	<a href="/recuperar-senha">Solicitar um novo link</a>
            	</p>
				<span class="text-center or-then">ou então</span>
				<p class="back-to-login">
                	<a href="/login">⬅️ Voltar para o Log in</a>
            	</p>
			</div>
		<% } %>
	</main>

	<% if (success) { %>
		<script src="/js/reset-password.js"></script>
	<% } %>

</body>
</html>