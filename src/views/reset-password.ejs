<!doctype html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Alterar Senha | jjOutOfBounds</title>
	<meta name="description" content="Redefinir sua senha cadastrada no site jjOutOfBounds.">

    <link rel="stylesheet" href="/css/reset-password.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
	<header class="title-box">
		<h1 class="blog-title">
			<a href="/" aria-label="Página inicial do blog">jjOutOfBounds</a>
		</h1>
	</header>
	
	<main>
		<% if (success) { %>
			<div class="main-box card-hover-effect">
				<h2>Alterar Senha</h2>
				<form id="resetPasswordForm">
					<input id="resetToken" name="resetToken" type="hidden" value="<%= resetToken %>">

					<div class="form-group">
						<label for="password">Nova senha <span class="required" aria-hidden="true">*</span></label>
						<div class="password-wrapper">
							<input 
								id="passwordInput" 
								name="password" 
								type="password" 
								minlength="8"
								autocomplete="new-password" 
								aria-describedby="passwordRequirements" 
								required
							>
							<button type="button" class="toggle-password" aria-label="Visualizar senha">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-labelledby="closedEyeIconTitle" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> 
									<title id="closedEyeIconTitle">Visualizar a senha</title> 
									<path d="M20 9C20 9 19.6797 9.66735 19 10.5144M12 14C10.392 14 9.04786 13.5878 7.94861 13M12 14C13.608 14 14.9521 13.5878 16.0514 13M12 14V17.5M4 9C4 9 4.35367 9.73682 5.10628 10.6448M7.94861 13L5 16M7.94861 13C6.6892 12.3266 5.75124 11.4228 5.10628 10.6448M16.0514 13L18.5 16M16.0514 13C17.3818 12.2887 18.3535 11.3202 19 10.5144M5.10628 10.6448L2 12M19 10.5144L22 12"/>
								</svg>
							</button>
						</div>
					</div>

					<div class="form-group">
						<label for="confirmPassword">Confirmar nova senha <span class="required" aria-hidden="true">*</span></label>
						<div class="password-wrapper">
							<input 
								id="confirmPasswordInput" 
								name="confirmPassword" 
								type="password"
								minlength="8"
								autocomplete="new-password" 
								required
							>
							<button type="button" class="toggle-password" aria-label="Visualizar senha">
								<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-labelledby="closedEyeIconTitle" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> 
									<title id="closedEyeIconTitle">Visualizar a senha</title> 
									<path d="M20 9C20 9 19.6797 9.66735 19 10.5144M12 14C10.392 14 9.04786 13.5878 7.94861 13M12 14C13.608 14 14.9521 13.5878 16.0514 13M12 14V17.5M4 9C4 9 4.35367 9.73682 5.10628 10.6448M7.94861 13L5 16M7.94861 13C6.6892 12.3266 5.75124 11.4228 5.10628 10.6448M16.0514 13L18.5 16M16.0514 13C17.3818 12.2887 18.3535 11.3202 19 10.5144M5.10628 10.6448L2 12M19 10.5144L22 12"/>
								</svg>
							</button>
						</div>
					</div>

					<small id="passwordRequirements" class="description-text">
						A senha deve ter no mínimo 8 caracteres, incluindo uma letra maiúscula, uma minúscula, um número e um caractere especial (ex: @, #, $, !).
					</small>

					<p id="feedbackMessage" class="feedback-message" role="alert" aria-live="assertive"></p>
					
					<button type="submit" id="submitBtn">Salvar Nova Senha</button>
				</form>
				<p class="back-to-login">
                	<a href="/login">⬅ Voltar para o Log in</a>
            	</p>
				<span class="text-center or-then">ou então</span>
				<p class="back-to-homepage">
					<a href="/">🏠 Página Principal</a>
				</p>
			</div>
		<% } else { %>
			<div class="main-box card-hover-effect">
				<p class="feedback-message error text-bigger text-center" role="alert" aria-live="assertive">
					<%= messagePt %>
				</p>
				<p class="back-to-login margin-top-bigger">
                	<a href="/recuperar-senha">Solicitar um novo link</a>
            	</p>
				<span class="text-center or-then">ou então</span>
				<p class="back-to-login">
                	<a href="/login">⬅ Voltar para o Log in</a>
            	</p>
			</div>
		<% } %>
	</main>

	<% if (success) { %>
		<script src="/js/reset-password.js"></script>
	<% } %>

</body>
</html>