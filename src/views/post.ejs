<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- O servidor injeta o título exato do post e o resumo para SEO -->
    <title><%= post.title %> | Blog Jair Junior</title>
    <meta name="description" content="<%= post.summary %>">
    
    <!-- CSS principal do site e estilo específico do post -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/post.css">

    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Cabeçalho Principal (idêntico ao index.ejs) -->
    <header class="site-header">
        <div class="container header-top">
            <h1 class="blog-title"><a href="/">jjOutOfBounds</a></h1>

            <!-- Botão Hamburger (Visível apenas em mobile) -->
            <button class="menu-toggle" aria-label="Abrir Menu" aria-expanded="false">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>

            <!-- Menu Superior (Alinhado à direita) -->
            <nav class="top-navbar">
                <ul>
                    <li><a href="#"><span class="buscar-text">Buscar</span> &#x1F50D;</a></li>
                    <li><a href="/posts">Artigos</a></li>
                    <li><a href="#">Sobre</a></li>
                    <li><a href="#">Contato</a></li>
                    <li><a href="#">Newsletter</a></li>
                    <li>
                        <a class="btn-login" href="/login">
                            <span>Entrar</span>
                            <svg class="login-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Menu Horizontal de Categorias -->
        <nav class="category-navbar container">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/posts/engenharia-de-software">Engenharia de Software</a></li>
                <li><a href="/posts/inteligencia-artificial">Inteligência Artificial</a></li>
                <li><a href="/posts/ciberseguranca">Cibersegurança</a></li>
                <li><a href="/posts/cloud-devops">Cloud & DevOps</a></li>
                <li><a href="/posts/infraestrutura-de-ti">Infraestrutura de TI</a></li>
                <li><a href="/posts/noticias-tech">Notícias Tech</a></li>
            </ul>
        </nav>
    </header>

    <!-- Conteúdo Principal do Artigo -->
    <main class="container main-content">

        <!-- Breadcrumb de Navegação -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/">Início</a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/posts/<%= post.category_slug %>">
                        <%= post.category_name %>
                    </a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item active" aria-current="page">
                    <%= post.title %>
                </li>
            </ol>
        </nav>

        <!-- Conteúdo do post -->
        <article class="single-post">
            
            <!-- Imagem de Capa Centralizada (exibida apenas se existir) -->
            <% if (post.cover_image) { %>
                <div class="post-cover-wrapper">
                    <img src="/img/<%= post.cover_image %>" alt="Imagem de capa do post <%= post.title %>" class="post-cover-featured">
                </div>
            <% } %>

            <!-- Cabeçalho do Artigo -->
            <header class="post-header">
                <h1 class="post-single-title"><%= post.title %></h1>
                
                <div class="post-meta">
                    <span class="post-meta-item">
                        📅 Publicado em <%= new Date(post.published_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                    </span>
                    <span class="post-meta-divider">•</span>
                    <span class="post-meta-item">
                        ✍️ Por <strong><%= post.author_name || 'Autor Desconhecido' %></strong>
                    </span>
                </div>
            </header>

            <!-- Conteúdo Principal Injetado pelo Servidor -->
            <div class="post-body">
                <%- post.content %> 
            </div>

        </article>


        <!-- Seção sobre o Autor -->
        <section class="author-section">
            <h2>Sobre o autor</h2>
            <div class="author-box">
                <div class="author-avatar-wrapper">
                    <img class="author-avatar" src="/img/profiles/<%= post.author_avatar %>" alt="Foto de perfil do autor <%= post.author_name %>">
                </div>
                <div class="author-info">
                    <h3 class="author-name"><%= post.author_name %></h3>
                    <p class="author-member-since">Membro desde <%= new Date(post.author_created_at).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %></p>
                    <p class="author-bio"><%= post.author_bio %></p>
                </div>
            </div>
        </section>


        <!-- Seção de comentários do post -->
        <section class="comments-section" id="comments">
            <h2>Comentários</h2>

            <!-- Área de envio: Exibe o formulário se o usuário estiver logado, ou aviso caso contrário -->
            <% if (isLoggedIn) { %>
                <form class="comment-form" action="/posts/<%= post.id %>/comments" method="POST">
                <div class="form-group">
                    <label for="content" class="sr-only">Escreva seu comentário</label>
                    <textarea 
                        id="content" 
                        name="content" 
                        rows="3" 
                        placeholder="O que você achou deste artigo?" 
                        required
                    ></textarea>
                </div>
                <button type="submit" class="btn-submit">Comentar</button>
                </form>
            <% } else { %>
                <div class="auth-prompt">
                <p>Você precisa <a href="/login">fazer login</a> para deixar um comentário.</p>
                </div>
            <% } %>

            <!-- Lista de Comentários -->
            <div class="comments-list">
                <% if (comments && comments.length > 0) { %>
                <% comments.forEach(function(comment) { %>
                    <div class="comment-item">
                    <img 
                        src="/images/avatars/<%= comment.avatar || 'default-avatar.jpeg' %>" 
                        alt="Avatar de <%= comment.author_name %>" 
                        class="comment-avatar"
                    />
                    <div class="comment-body">
                        <div class="comment-meta">
                        <span class="comment-author"><%= comment.author_name %></span>
                        <span class="comment-date"><%= comment.created_at %></span>
                        </div>
                        <p class="comment-text"><%= comment.content %></p>
                    </div>
                    </div>
                <% }); %>
                <% } else { %>
                <p class="no-comments">Ainda não existem comentários neste post. Seja o primeiro a comentar!</p>
                <% } %>
            </div>
        </section>

    </main>


    <!-- Rodapé -->
    <footer class="site-footer">
        <div class="container footer-content">
            <p>&copy; 2026 Blog Jair Junior. Todos os direitos reservados.</p>
            <div class="footer-links">
                <a href="/sobre">Sobre</a>
                <a href="/contato">Contato</a>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>

</body>
</html>