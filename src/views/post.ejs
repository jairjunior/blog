<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- O servidor injeta o título exato do post e o resumo para SEO -->
    <title><%= post.title %> | Blog Jair Junior</title>
    <meta name="description" content="<%= post.summary %>">
    
    <!-- CSS principal do site e estilo específico do post -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/post.css">
</head>
<body>

    <!-- Cabeçalho Principal (idêntico ao index.ejs) -->
    <header class="site-header">
        <div class="container header-top">
            <h1 class="blog-title"><a href="/">Blog Jair Junior</a></h1>
            <a href="/login" class="login-btn">Entrar</a>
        </div>

        <!-- Menu Horizontal de Categorias -->
        <nav class="category-nav">
            <div class="container">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/posts">Todos os Posts</a></li>
                    <li><a href="/posts/engenharia-de-software">Engenharia de Software</a></li>
                    <li><a href="/posts/inteligencia-artificial">Inteligência Artificial</a></li>
                    <li><a href="/posts/ciberseguranca">Cibersegurança</a></li>
                    <li><a href="/posts/cloud-devops">Cloud & DevOps</a></li>
                    <li><a href="/posts/infraestrutura-de-ti">Infraestrutura de TI</a></li>
                    <li><a href="/posts/noticias-tech">Notícias Tech</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <!-- Conteúdo Principal do Artigo -->
    <main class="container main-content">

        <!-- Breadcrumb de Navegação -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/">Início</a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/posts/<%= post.category_slug %>">
                        <%= post.category_name %>
                    </a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item active" aria-current="page">
                    <%= post.title %>
                </li>
            </ol>
        </nav>

        <article class="single-post">
            
            <!-- Imagem de Capa Centralizada (exibida apenas se existir) -->
            <% if (post.cover_image) { %>
                <div class="post-cover-wrapper">
                    <img src="/img/<%= post.cover_image %>" alt="Imagem de capa do post <%= post.title %>" class="post-cover-featured">
                </div>
            <% } %>

            <!-- Cabeçalho do Artigo -->
            <header class="post-header">
                <h1 class="post-single-title"><%= post.title %></h1>
                
                <div class="post-meta">
                    <span class="post-meta-item">
                        📅 Publicado em <%= new Date(post.published_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                    </span>
                    <span class="post-meta-divider">•</span>
                    <span class="post-meta-item">
                        ✍️ Por <strong><%= post.author_name || 'Autor Desconhecido' %></strong>
                    </span>
                </div>
            </header>

            <!-- Conteúdo Principal Injetado pelo Servidor -->
            <div class="post-body">
                <%- post.content %> 
            </div>

        </article>
    </main>

    <!-- Rodapé (idêntico ao index.ejs) -->
    <footer class="site-footer">
        <div class="container footer-content">
            <p>&copy; 2026 Blog Jair Junior. Todos os direitos reservados.</p>
            <div class="footer-links">
                <a href="/sobre">Sobre</a>
                <a href="/contato">Contato</a>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>

</body>
</html>