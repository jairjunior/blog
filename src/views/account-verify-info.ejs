<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Informações para Confirmação de E-mail | outOfBounds</title>
    <meta name="description" content="Instruções para ativar sua conta no site outOfBounds.">
    <meta name="robots" content="noindex, nofollow">

    <link rel="stylesheet" href="/css/account-verify-info.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
    <header class="title-box">
        <h1 class="blog-title">
            <a href="/" aria-label="Página inicial do outOfBounds">outOfBounds</a>
        </h1>
    </header>
    
    <main>
        <div class="main-box card-hover-effect" id="verificationCard" data-email-failed="<%= (typeof verificationEmailFailure !== 'undefined' && verificationEmailFailure) ? 'true' : 'false' %>">

            <div class="icon-badge" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"/>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                </svg>
            </div>

            <h2>Quase lá<%= typeof firstName !== 'undefined' && firstName ? `, ${firstName}` : '' %>!</h2>
            
            <% if (typeof verificationEmailFailure !== 'undefined' && verificationEmailFailure) { %>
                <div class="feedback-message error" role="alert" aria-live="assertive" style="margin-bottom: 1.25rem; text-align: left; padding: 0.85rem;">
                    ⚠️ <strong>Aviso:</strong> Sua conta foi criada com sucesso, mas tivemos uma falha temporária ao enviar o e-mail de confirmação. Você pode tentar reenviar o link agora mesmo no botão abaixo. Se o problema persistir, entre em contato conosco pela <a href="/contato" style="color: inherit; text-decoration: underline; font-weight: bold;">página de suporte</a>.
                </div>
            <% } else { %>
                <p class="description-text">
                    Enviamos um link de confirmação para o endereço:
                </p>
            <% } %>

            <div class="email-highlight" id="userEmailDisplay" data-email="<%= typeof email !== 'undefined' && email ? email : '' %>">
                <%= typeof email !== 'undefined' && email ? email : 'seu e-mail cadastrado' %>
            </div>

            <div class="instructions-box">
                <p><strong>Próximos passos:</strong></p>
                <ol>
                    <li>Abra sua caixa de entrada e procure pelo e-mail do <strong>outOfBounds</strong>.</li>
                    <li>Clique no botão ou link de ativação dentro da mensagem.</li>
                    <li>Pronto! Após confirmar, você já poderá fazer login normalmente.</li>
                </ol>
            </div>

            <p class="spam-notice">
                💡 Não encontrou? Verifique sua pasta de <strong>Spam</strong> ou <strong>Lixo Eletrônico</strong>. O link expira em <strong>24 horas</strong>.
            </p>

            <p id="feedbackMessage" class="feedback-message"></p>

            <% if (typeof email !== 'undefined' && email) { %>
                <button type="button" id="resendBtn" class="btn-secondary">
                    <span class="btn-text">Reenviar e-mail de confirmação</span>
                </button>
            <% } %>

            <div class="box-divider"></div>

            <p class="back-to-homepage">
                <a href="/">🏠 Página Principal</a>
            </p>
        </div>
    </main>

    <% if (typeof email !== 'undefined' && email) { %>
        <script src="/js/account-verify-info.js"></script>
    <% } %>
</body>
</html>