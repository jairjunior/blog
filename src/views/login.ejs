<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Log in | jjOutOfBounds</title>

	<!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/login.css">

	<!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">

</head>


<body>
	<div class="title-box">
		<h1 class="blog-title"><a href="/">jjOutOfBounds</a></h1>
	</div>
	
	<main>
		<div class="login-box">
			<h2>Log in</h2>	
			<form id="loginForm">
				<input id="redirectTo" name="redirectTo" type="hidden" value="<%= redirectTo %>">

				<label for="email">E-mail</label>
				<input id="email" name="email" type="email" autocomplete="email" required>

				<label for="password">Senha</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required>

				<p id="responseMessage" class="error-message"></p>

				<button type="submit">Entrar</button>
			</form>
			<p class="recovery"><a href="/forgot-password">Esqueceu a senha?</a></p>
			<span class="text-center">ou então</span>
			<p class="register"><a href="/register">Crie uma conta gratuitamente</a></p>
		</div>
	</main>

	<script src="/js/login.js"></script>

</body>
</html>
