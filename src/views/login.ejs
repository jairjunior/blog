<!doctype html>
<html lang="pt-BR">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Entrar | jjOutOfBounds</title>
	<meta name="description" content="Realizar login com sua conta cadastrada no jjOutOfBounds.">

	<!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/login.css">

	<!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
	<header class="title-box">
		<h1 class="blog-title">
			<a href="/" aria-label="Página inicial do blog">jjOutOfBounds</a>
		</h1>
	</header>
	
	<main>
		<div class="main-box card-hover-effect">
			<h2>Entrar</h2>	
			<form id="loginForm">
				<input id="redirectTo" name="redirectTo" type="hidden" value="<%= redirectTo %>">

				<div class="form-group">
					<label for="email">E-mail <span class="required" aria-hidden="true">*</span></label>
					<input 
						id="email" 
						name="email" 
						type="email" 
						autocomplete="email" 
						placeholder="seu.email@exemplo.com" 
						required
					>
				</div>

				<div class="form-group">
					<label for="password">Senha <span class="required" aria-hidden="true">*</span></label>
					<input 
					id="password" 
					name="password" 
					type="password" 
					autocomplete="current-password" 
					placeholder="Sua senha" 
					required
				>
				</div>

				<p id="feedbackMessage" class="feedback-message" role="alert" aria-live="assertive"></p>

				<button type="submit">Entrar</button>
			</form>
			<p class="recovery">
				<a href="/recuperar-senha">Esqueceu a senha?</a>
			</p>
			<span class="text-center or-then">ou então</span>
			<p class="register">
				<a href="/cadastrar">Crie uma conta gratuitamente</a>
			</p>
		</div>
	</main>

	<script src="/js/login.js"></script>

</body>
</html>
