<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Recuperar Senha | jjOutOfBounds</title>
    <meta name="description" content="Recuperar a senha da sua conta no jjOutOfBounds.">

    <!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/forgot-password.css">

    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
    <header class="title-box">
        <h1 class="blog-title">
            <a href="/" aria-label="Página inicial do blog">jjOutOfBounds</a>
        </h1>
    </header>
    
    <main>
        <div class="main-box card-hover-effect">
            <h2>Recuperar Senha</h2>
            <p class="description-text">
                Digites o seu e-mail. Se ele estiver cadastrado, você receberá um link de redefinição válido por <strong>15 minutos</strong>.
            </p>

            <form id="forgotForm" novalidate>
                <div class="form-group">
                    <label for="emailInput">E-mail <span class="required" aria-hidden="true">*</span></label>
                    <input 
                        id="emailInput" 
                        name="email" 
                        type="email" 
                        autocomplete="email" 
                        placeholder="seu.email@exemplo.com"
                        aria-required="true" 
                        required 
                    >
                </div>

                <div id="feedbackMessage" class="feedback-message" role="alert" aria-live="assertive"></div>

                <button type="submit" id="submitBtn">
                    <span class="btn-text">Enviar Link de Recuperação</span>
                </button>
            </form>

            <p class="back-to-login">
                <a href="/login">⬅️ Voltar para o Log in</a>
            </p>
            <span class="text-center or-then">ou então</span>
            <p class="back-to-homepage">
                <a href="/">🏠 Página Principal</a>
            </p>
        </div>
    </main>

    <script src="/js/forgot-password.js"></script>
</body>
</html>