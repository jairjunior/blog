<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Recuperar Senha | outOfBounds</title>
    <meta name="description" content="Recuperar a senha da sua conta no site outOfBounds.">
    <meta name="robots" content="noindex, nofollow">

    <link rel="stylesheet" href="/css/forgot-password.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
    <header class="title-box">
        <h1 class="blog-title">
            <a href="/" aria-label="Página inicial do site outOfBounds">outOfBounds</a>
        </h1>
    </header>
    
    <main>
        <div class="main-box card-hover-effect">
            <h2>Recuperar Senha</h2>
            <p class="description-text">
                Digite o seu e-mail. Se ele estiver cadastrado, você receberá um link de redefinição válido por <strong>15 minutos</strong>.
            </p>

            <form id="forgotForm" novalidate>
                <div class="form-group">
                    <label for="emailInput">E-mail <span class="required" aria-hidden="true">*</span></label>
                    <input 
                        id="emailInput" 
                        name="email" 
                        type="email" 
                        autocomplete="email" 
                        placeholder="seu.email@exemplo.com"
                        aria-required="true" 
                        required 
                    >
                </div>

                <p id="feedbackMessage" class="feedback-message"></p>

                <button type="submit" id="submitBtn">
                    <svg 
                        xmlns="http://www.w3.org/2000/svg" 
                        width="20" 
                        height="20" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round" 
                        aria-hidden="true"
                        focusable="false"
                    >
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                    Enviar Link de Recuperação
                </button>
            </form>

            <div class="box-divider"></div>

            <p class="back-to-login">
                <a href="/login">⬅ Voltar para o Login</a>
            </p>
            <span class="text-center or-then">ou então</span>
            <p class="back-to-homepage">
                <a href="/">🏠 Página Principal</a>
            </p>
        </div>
    </main>

    <script src="/js/forgot-password.js"></script>
</body>
</html>