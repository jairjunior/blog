<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- O servidor injeta o título exato do artigo e o resumo para SEO -->
    <title><%= article.title %> | outOfBounds</title>
    <meta name="description" content="<%= article.summary %>">
    
    <!-- CSS principal do site e estilo específico do artigo -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/article.css">

    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Cabeçalho Principal -->
    <%- include('partials/header', { currentUrl: currentUrl, user: user }) %>

    <!-- Conteúdo Principal do Artigo -->
    <main class="container main-content">

        <!-- Breadcrumb -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/">Início</a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/artigos">Artigos</a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/artigos/<%= article.category_slug %>">
                        <%= article.category_name %>
                    </a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item active" aria-current="page">
                    <%= article.title %>
                </li>
            </ol>
        </nav>

        <!-- Conteúdo do artigo -->
        <article class="single-post">
            
            <!-- Imagem de Capa Centralizada (exibida apenas se existir) -->
            <% if (article.cover_image) { %>
                <div class="post-cover-wrapper">
                    <img src="/img/<%= article.cover_image %>" alt="Imagem de capa para o artigo <%= article.title %>" class="post-cover-featured">
                </div>
            <% } %>

            <!-- Cabeçalho do Artigo -->
            <header class="post-header">
                <h1 class="post-single-title"><%= article.title %></h1>
                
                <div class="post-meta">
                    <span class="post-meta-item">
                        📅 Publicado em <%= new Date(article.published_at).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                    </span>
                    <span class="post-meta-divider">•</span>
                    <span class="post-meta-item">
                        ✍️ Por <strong><%= article.author_name || 'Autor Desconhecido' %></strong>
                    </span>
                </div>
            </header>

            <!-- Conteúdo Principal Injetado pelo Servidor -->
            <div class="post-body">
                <%- article.content %> 
            </div>

        </article>


        <!-- Seção sobre o Autor -->
        <section class="author-section">
            <h2>Sobre o autor</h2>
            <div class="author-box">
                <div class="author-avatar-wrapper">
                    <img class="author-avatar" src="/img/profiles/<%= article.author_avatar %>" alt="Foto de perfil do autor <%= article.author_name %>">
                </div>
                <div class="author-info">
                    <h3 class="author-name"><%= article.author_name %></h3>
                    <p class="author-member-since">Membro desde <%= new Date(article.author_created_at).toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }) %></p>
                    <p class="author-bio"><%= article.author_bio %></p>
                </div>
            </div>
        </section>


        <!-- Seção de comentários do artigo -->
        <section class="comments-section" id="comments">
            <h2>Comentários</h2>
            <% if (user && user.isVerified === true) { %>
                <form id="commentForm" class="comment-form">
                    <div class="form-group">
                        <label for="commentTextArea" class="sr-only">Escreva seu comentário</label>
                        <textarea 
                            id="commentTextArea" 
                            name="content" 
                            rows="3" 
                            placeholder="O que você achou deste artigo?" 
                            required
                        ></textarea>
                    </div>
                    
                    <p id="commentFeedbackMessage" class="comment-feedback-message error-message"></p>

                    <div class="comment-submit-btn-wrapper">
                        <button type="submit" id="commentSubmitBtn" class="comment-submit-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <line x1="22" y1="2" x2="11" y2="13"></line>
                                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                            </svg>
                            Comentar
                        </button>
                    </div>
                </form>
            <% } else if (user && user.isVerified === false) { %>
                <div class="auth-prompt">
                    <p>Você precisa <a href="/informacoes-para-verificar-conta">verificar a sua conta</a> 
                        para deixar um comentário.</p>
                </div>
            <% } else { %>
                <div class="auth-prompt">
                    <p>Você precisa <a href="/login?redirectTo=<%= encodeURIComponent(currentUrl) %>">fazer login</a> 
                        para deixar um comentário.</p>
                </div>
            <% } %>

            <!-- Lista de Comentários -->
            <div class="comments-list">
                <% if (comments && comments.length > 0) { %>
                    <% comments.forEach(function(comment) { %>
                        <div class="comment-item">
                            <img
                                class="comment-avatar"
                                src="/img/profiles/<%= comment.avatar || 'default-avatar.jpeg' %>" 
                                alt="Avatar do usuário <%= comment.author_name %>"
                            />
                            <div class="comment-body">
                                <div class="comment-meta">
                                    <span class="comment-author"><%= comment.user_name %></span>
                                    <span class="comment-date"><%= comment.created_at %></span>
                                </div>
                                <p class="comment-text"><%= comment.content %></p>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p class="no-comments">Ainda não existem comentários neste artigo. Seja o primeiro a comentar!</p>
                <% } %>
            </div>
        </section>

    </main>


    <!-- Rodapé -->
    <%- include('partials/footer') %>


    <!-- Modal de Re-login rápido -->
    <div id="reauthModal" class="reauth-modal">
        <div class="modal-content">
            <h3>Sua sessão expirou</h3>
            <p class="modal-info-message">Efetue o login novamente para enviar seu comentário sem perdê-lo.</p>
            <form id="reauthModalForm">
                <label for="modalEmail" class="sr-only">E-mail:</label>
                <input type="email" id="modalEmail" name="email" autocomplete="email" placeholder="seu.email@exemplo.com" required>

                <label for="modalPassword" class="sr-only">Senha:</label>
                <input type="password" id="modalPassword" name="password" autocomplete="current-password" placeholder="Senha" required>
                
                <p id="modalLoginFeedbackMessage" class="error-message"></p>

                <button type="submit" class="reauth-modal-btn">Efetuar Login e Postar Comentário</button>
            </form>
        </div>
    </div>

    <script src="/js/main.js"></script>
    <script src="/js/article.js"></script>

</body>
</html>