<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Jair Junior</title>
    
    <!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/main.css">
    
    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Cabeçalho Principal -->
    <%- include('partials/header', { currentUrl: currentUrl, user: user }) %>

    <!-- Conteúdo Principal -->
    <main class="container main-content">

        <!-- Breadcrumb de Navegação -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    Início
                </li>
            </ol>
        </nav>

        <!-- Seção para mostrar os posts da categoria -->
        <section class="posts-section">
            <h2>Últimas Postagens</h2>

            <div class="posts-grid">
                <% if (latestPosts && latestPosts.length > 0) { %>
                    <% latestPosts.forEach(post => { %>
                        <article class="post-card">
                            <% if (post.cover_image) { %>
                                <img src="/img/<%= post.cover_image %>" alt="Imagem representativa do post <%= post.title %>" class="post-cover">
                            <% } %>
                            <div class="post-info">
                                <span class="post-date">
                                    <%= new Date(post.published_at).toLocaleDateString('pt-BR') %>
                                </span>
                                <h3><a href="/posts/<%= post.category_slug %>/<%= post.slug %>"><%= post.title %></a></h3>
                                <p class="post-summary"><%= post.summary || 'Leia o artigo completo...' %></p>
                                <p class="post-author">Por <%= post.author_name %></p>
                                <a href="/posts/<%= post.category_slug %>/<%= post.slug %>" class="read-more">Ler artigo &rarr;</a>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p class="no-posts">Nenhum post encontrado no momento.</p>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Rodapé -->
    <%- include('partials/footer') %>
    
    <script src="/js/main.js"></script>

</body>
</html>