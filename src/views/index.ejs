<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home | outOfBounds</title>
    <meta name="description" content="Página principal do site outOfBounds, com os principais artigos sobre engenharia de software, inteligência artificial, cibersegurança, cloud & DevOps e também notícias do universo da tecnologia da informação.">
    
    <!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/header.css">
    
    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Cabeçalho Principal do site (topo da página) -->
    <%- include('partials/header', { currentUrl: currentUrl, user: user }) %>

    <!-- Conteúdo Principal -->
    <main class="container main-content">

        <!-- Breadcrumb de Navegação -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    Início
                </li>
            </ol>
        </nav>

        <!-- Seção para mostrar os artigos da categoria -->
        <section class="articles-section">
            <h2>Últimos Artigos</h2>

            <div class="articles-grid">
                <% if (latestArticles && latestArticles.length > 0) { %>
                    <% latestArticles.forEach(article => { %>
                        <article class="article-card">
                            <% if (article.cover_image) { %>
                                <img src="/img/<%= article.cover_image %>" alt="Imagem representativa do artigo <%= article.title %>" class="article-cover">
                            <% } %>
                            <div class="article-info">
                                <span class="article-date">
                                    <%= new Date(article.published_at).toLocaleDateString('pt-BR') %>
                                </span>
                                <h3><a href="/artigos/<%= article.category_slug %>/<%= article.slug %>"><%= article.title %></a></h3>
                                <p class="article-summary"><%= article.summary || 'Leia o artigo completo...' %></p>
                                <p class="article-author">Por <%= article.author_name %></p>
                                <a href="/artigos/<%= article.category_slug %>/<%= article.slug %>" class="read-more">Ler artigo &rarr;</a>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p class="no-articles">Nenhum artigo encontrado no momento.</p>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Rodapé -->
    <%- include('partials/footer') %>
    
    <script src="/js/main.js"></script>

</body>
</html>