<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Criar Conta | jjOutOfBounds</title>
    <meta name="description" content="Cadastre-se gratuitamente no jjOutOfBounds para comentar nos artigos, curtir conteúdos e receber newsletters exclusivas sobre engenharia de software e desenvolvimento web.">

    <!-- Estilo principal de cadastro -->
    <link rel="stylesheet" href="/css/register.css">

    <!-- Fonte Outfit do Google Fonts (Idêntica à tela de login) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
    <!-- Título / Logotipo Principal -->
    <header class="title-box">
        <h1 class="blog-title">
            <a href="/" aria-label="Ir para a página inicial do jjOutOfBounds">jjOutOfBounds</a>
        </h1>
    </header>

    <main class="register-container">
        <!-- Card 1: Vantagens e Destaque (Empilhado no topo até 1199px; Lado a lado a partir de 1200px) -->
        <section class="benefits-card card-hover-effect" aria-labelledby="benefitsheading">
            <div class="badge-quick">⚡ Cadastro Rápido & Descomplicado</div>
            <h2 id="benefitsheading" class="benefits-title">Desbloqueie acesso total</h2>
            <p class="benefits-subtitle">
                Precisamos apenas do seu <strong>nome e e-mail</strong> para criar uma conta gratuitamente!
            </p>

            <ul class="benefits-list">
                <li class="benefit-item">
                    <div class="benefit-icon" aria-hidden="true">💬</div>
                    <div>
                        <h3>Comente nos artigos</h3>
                        <p>Participe de discussões técnicas sobre os diversos temas do site.</p>
                    </div>
                </li>
                <li class="benefit-item">
                    <div class="benefit-icon" aria-hidden="true">👍</div>
                    <div>
                        <h3>Like & Dislike</h3>
                        <p>Avalie conteúdos, dê feedback direto nos artigos e ajude a comunidade.</p>
                    </div>
                </li>
                <li class="benefit-item">
                    <div class="benefit-icon" aria-hidden="true">🧠</div>
                    <div>
                        <h3>Quizzes técnicos interativos</h3>
                        <p>Teste o que aprendeu ao final dos artigos com gabaritos comentados.</p>
                    </div>
                </li>
                <li class="benefit-item">
                    <div class="benefit-icon" aria-hidden="true">📋</div>
                    <div>
                        <h3>Cópia rápida de code snippets</h3>
                        <p>Copie trechos de código com um clique.</p>
                    </div>
                </li>
                <li class="benefit-item">
                    <div class="benefit-icon" aria-hidden="true">📬</div>
                    <div>
                        <h3>Newsletter Exclusiva</h3>
                        <p>Receba resumos semanais de artigos técnicos e novidades no seu e-mail.</p>
                    </div>
                </li>
            </ul>
        </section>

        <!-- Card 2: Formulário de Cadastro -->
        <section class="register-box" aria-labelledby="formheading">
            <h2 id="formheading" class="form-title">Criar Conta</h2>
            
            <form id="registerForm" novalidate>
                <!-- Nome e Sobrenome alinhados em duas colunas em telas maiores -->
                <div class="form-row">
                    <div class="form-group">
                        <label for="firstNameInput">Primeiro Nome <span class="required" aria-hidden="true">*</span></label>
                        <input 
                            id="firstNameInput" 
                            name="firstName" 
                            type="text" 
                            autocomplete="given-name" 
                            required 
                            maxlength="50"
                            placeholder="Seu primeiro nome"
                            aria-required="true"
                        >
                    </div>

                    <div class="form-group">
                        <label for="lastNameInput">Sobrenome <span class="required" aria-hidden="true">*</span></label>
                        <input 
                            id="lastNameInput" 
                            name="lastName" 
                            type="text" 
                            autocomplete="family-name" 
                            required 
                            maxlength="100"
                            placeholder="Seu sobrenome"
                            aria-required="true"
                        >
                    </div>
                </div>

                <!-- E-mail com RegEx nativo do HTML5 e Notificação customizada de instrução -->
                <div class="form-group">
                    <label for="emailInput">E-mail <span class="required" aria-hidden="true">*</span></label>
                    <input 
                        id="emailInput" 
                        name="email" 
                        type="email" 
                        autocomplete="email" 
                        required 
                        placeholder="seu.email@exemplo.com"
                        aria-required="true"
                        aria-describedby="emailHelp"
                    >
                </div>

                <!-- Senha -->
                <div class="form-group">
                    <label for="passwordInput">Senha <span class="required" aria-hidden="true">*</span></label>
                    <div class="password-wrapper">
                        <input 
                            id="passwordInput" 
                            name="password" 
                            type="password" 
                            autocomplete="new-password" 
                            required 
                            minlength="8"
                            placeholder="Escolha uma senha forte"
                            aria-required="true"
                        >
                        <button type="button" class="toggle-password" aria-label="Visualizar senha">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-labelledby="closedEyeIconTitle" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> 
								<title id="closedEyeIconTitle">Visualizar a senha</title> 
								<path d="M20 9C20 9 19.6797 9.66735 19 10.5144M12 14C10.392 14 9.04786 13.5878 7.94861 13M12 14C13.608 14 14.9521 13.5878 16.0514 13M12 14V17.5M4 9C4 9 4.35367 9.73682 5.10628 10.6448M7.94861 13L5 16M7.94861 13C6.6892 12.3266 5.75124 11.4228 5.10628 10.6448M16.0514 13L18.5 16M16.0514 13C17.3818 12.2887 18.3535 11.3202 19 10.5144M5.10628 10.6448L2 12M19 10.5144L22 12"/>
							</svg>
						</button>
                    </div>
                    <small class="input-hint"">
						A senha deve ter no mínimo 8 caracteres, incluindo uma letra maiúscula, uma minúscula, um número e um caractere especial (ex: @, #, $, !).
					</small>
                </div>

                <!-- Confirmar Senha -->
                <div class="form-group">
                    <label for="confirmPasswordInput">Confirme a senha <span class="required" aria-hidden="true">*</span></label>
                    <div class="password-wrapper">
                        <input 
                            id="confirmPasswordInput" 
                            name="confirmPassword" 
                            type="password" 
                            autocomplete="new-password" 
                            required 
                            minlength="8"
                            placeholder="Repita a senha escolhida"
                            aria-required="true"
                        >
                        <button type="button" class="toggle-password" aria-label="Visualizar senha">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-labelledby="closedEyeIconTitle" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> 
								<title id="closedEyeIconTitle">Visualizar a senha</title> 
								<path d="M20 9C20 9 19.6797 9.66735 19 10.5144M12 14C10.392 14 9.04786 13.5878 7.94861 13M12 14C13.608 14 14.9521 13.5878 16.0514 13M12 14V17.5M4 9C4 9 4.35367 9.73682 5.10628 10.6448M7.94861 13L5 16M7.94861 13C6.6892 12.3266 5.75124 11.4228 5.10628 10.6448M16.0514 13L18.5 16M16.0514 13C17.3818 12.2887 18.3535 11.3202 19 10.5144M5.10628 10.6448L2 12M19 10.5144L22 12"/>
							</svg>
						</button>
                    </div>
                </div>

                <!-- Mensagem de feedback para o usuário -->
                <p id="feedbackMessage" class="feedback-message" role="alert" aria-live="assertive"></p>

                <!-- Botão com ícone animado de engrenagem para carregamento -->
                <button type="submit" id="submitBtn" class="btn-submit">
                    <svg class="top-auth-btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="8.5" cy="7" r="4"></circle>
                        <line x1="20" y1="8" x2="20" y2="14"></line>
                        <line x1="23" y1="11" x2="17" y2="11"></line>
                    </svg>
                    <span class="btn-text">Criar Minha Conta</span>
                </button>
            </form>

            <span class="text-center divider-text">Já possui uma conta?</span>
            <p class="login-link"><a href="/login">Fazer Log in</a></p>
        </section>
    </main>

    <script src="/js/register.js"></script>
</body>
</html>