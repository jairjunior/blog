<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Confirmação de E-mail | outOfBounds</title>
    <meta name="description" content="Confirmação de conta no site outOfBounds.">
    <meta name="robots" content="noindex, nofollow">

    <link rel="stylesheet" href="/css/account-verify.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>

<body>
    <header class="title-box">
        <h1 class="blog-title">
            <a href="/" aria-label="Página inicial do site outOfBounds">outOfBounds</a>
        </h1>
    </header>
    
    <main>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="main-box card-hover-effect">
                <div class="success-icon-wrapper" aria-hidden="true">🎉</div>
                <h2>Conta Verificada!</h2>
                <p class="description-text">
                    Olá, <strong><%= typeof userName !== 'undefined' ? userName : '' %></strong>! 
                    Seu e-mail foi confirmado com sucesso. Agora você tem acesso total aos comentários, 
                    quizzes interativos, reações e recursos exclusivos do <strong>outOfBounds</strong>.
                </p>
                
                <div class="countdown-wrapper">
                    <p>Você será redirecionado para a página inicial em <span id="countdownNumber"></span> segundos...</p>
                </div>

                <a href="/" id="homeLink" class="btn-return-home">
                    <svg 
                        xmlns="http://www.w3.org/2000/svg" 
                        width="20" 
                        height="20" 
                        viewBox="0 0 24 24" 
                        fill="none" 
                        stroke="currentColor" 
                        stroke-width="2.2" 
                        stroke-linecap="round" 
                        stroke-linejoin="round" 
                        aria-hidden="true" 
                        focusable="false"
                    >
                        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                        <polyline points="9 22 9 12 15 12 15 22"></polyline>
                    </svg>
                    <span>Ir para a Página Principal Agora</span>
                </a>
            </div>
        <% } else { %>
            <div class="main-box card-hover-effect">
                <div class="error-icon-wrapper" aria-hidden="true">⚠️</div>
                <h2>Falha na Verificação</h2>
                <p class="feedback-message error" role="alert" aria-live="assertive">
                    <%= typeof messagePt !== 'undefined' ? messagePt : '' %>
                </p>
                <p class="description-text margin-top-smaller">
                    O link pode ter expirado (validade de 24 horas) ou já ter sido utilizado.
                </p>

                <div class="box-divider"></div>
                
                <p class="back-to-login margin-top-bigger">
                    <a href="/informacoes-para-verificar-conta">Solicitar um novo link de verificação</a>
                </p>
                <span class="or-then">ou então</span>
                <p class="back-to-login">
                    <a href="/login">⬅ Voltar para o Login</a>
                </p>
            </div>
        <% } %>
    </main>

    <% if (typeof success !== 'undefined' && success) { %>
        <!-- Biblioteca CDN leve para confetes festivos -->
        <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
        <script src="/js/account-verify.js"></script>
    <% } %>
</body>
</html>