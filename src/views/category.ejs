<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= categoryName %> | outOfBounds</title>
    
    <!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/main.css">
    
    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Cabeçalho Principal -->
    <%- include('partials/header', { currentUrl: currentUrl, user: user }) %>

    <!-- Conteúdo Principal -->
    <main class="container main-content">
        
        <!-- Breadcrumb de Navegação -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/">Início</a>
                </li>

                <li class="breadcrumb-separator">/</li>

                <% if (categoryName === 'Artigos') { %>
                    <li class="breadcrumb-item">
                        <%= categoryName %>
                    </li>
                <% } else { %>
                    <li class="breadcrumb-item">
                        <a href="/artigos">Artigos</a>
                    </li>

                    <li class="breadcrumb-separator">/</li>

                    <li class="breadcrumb-item">
                        <%= categoryName %>
                    </li>
                <% } %>
            </ol>
        </nav>

        <!-- Seção para mostrar os artigos da categoria -->
        <section class="articles-section">
            <h2>Últimas Postagens</h2>

            <div class="articles-grid">
                <% if (articles && articles.length > 0) { %>
                    <% articles.forEach(article => { %>
                        <article class="post-card">
                            <% if (article.cover_image) { %>
                                <img src="/img/<%= article.cover_image %>" alt="Imagem representativa do artigo <%= article.title %>" class="post-cover">
                            <% } %>
                            <div class="post-info">
                                <span class="post-date">
                                    <%= new Date(article.published_at).toLocaleDateString('pt-BR') %>
                                </span>
                                <h3><a href="/artigos/<%= article.category_slug %>/<%= article.slug %>"><%= article.title %></a></h3>
                                <p class="post-summary"><%= article.summary || 'Leia o artigo completo...' %></p>
                                <p class="post-author">Por <%= article.author_name %></p>
                                <a href="/artigos/<%= article.category_slug %>/<%= article.slug %>" class="read-more">Ler artigo &rarr;</a>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p class="no-articles">Nenhum artigo encontrado no momento.</p>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Rodapé -->
    <%- include('partials/footer') %>

    <script src="/js/main.js"></script>

</body>
</html>