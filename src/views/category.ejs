<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Jair Junior</title>
    
    <!-- Link para o arquivo CSS estático -->
    <link rel="stylesheet" href="/css/main.css">
    
    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>
<body>

    <!-- Cabeçalho Principal -->
    <header class="site-header">
        <div class="container header-top">
            <h1 class="blog-title"><a href="/">jjOutOfBounds</a></h1>

            <!-- Botão Hamburger (Visível apenas em mobile) -->
            <button class="menu-toggle" aria-label="Abrir Menu" aria-expanded="false">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>

            <!-- Menu Superior (Alinhado à direita) -->
            <nav class="top-navbar">
                <ul>
                    <li><a href="#"><span class="buscar-text">Buscar</span> &#x1F50D;</a></li>
                    <li><a href="/posts">Artigos</a></li>
                    <li><a href="#">Sobre</a></li>
                    <li><a href="#">Contato</a></li>
                    <li><a href="#">Newsletter</a></li>
                    <li>
                        <a class="btn-login" href="/login">
                            <span>Entrar</span>
                            <svg class="login-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Menu Horizontal de Categorias -->
        <nav class="category-navbar container">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/posts/engenharia-de-software">Engenharia de Software</a></li>
                <li><a href="/posts/inteligencia-artificial">Inteligência Artificial</a></li>
                <li><a href="/posts/ciberseguranca">Cibersegurança</a></li>
                <li><a href="/posts/cloud-devops">Cloud & DevOps</a></li>
                <li><a href="/posts/infraestrutura-de-ti">Infraestrutura de TI</a></li>
                <li><a href="/posts/noticias-tech">Notícias Tech</a></li>
            </ul>
        </nav>
    </header>

    <!-- Conteúdo Principal -->
    <main class="container main-content">
        
        <!-- Breadcrumb de Navegação -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/">Início</a>
                </li>
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <%= categoryName %>
                </li>
            </ol>
        </nav>

        <!-- Seção para mostrar os posts da categoria -->
        <section class="posts-section">
            <h2>Últimas Postagens</h2>

            <div class="posts-grid">
                <% if (posts && posts.length > 0) { %>
                    <% posts.forEach(post => { %>
                        <article class="post-card">
                            <% if (post.cover_image) { %>
                                <img src="/img/<%= post.cover_image %>" alt="Imagem representativa do post <%= post.title %>" class="post-cover">
                            <% } %>
                            <div class="post-info">
                                <span class="post-date">
                                    <%= new Date(post.published_at).toLocaleDateString('pt-BR') %>
                                </span>
                                <h3><a href="/posts/<%= post.category_slug %>/<%= post.slug %>"><%= post.title %></a></h3>
                                <p class="post-summary"><%= post.summary || 'Leia o artigo completo...' %></p>
                                <p class="post-author">Por <%= post.author_name %></p>
                                <a href="/posts/<%= post.category_slug %>/<%= post.slug %>" class="read-more">Ler artigo &rarr;</a>
                            </div>
                        </article>
                    <% }) %>
                <% } else { %>
                    <p class="no-posts">Nenhum post encontrado no momento.</p>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Rodapé -->
    <footer class="site-footer">
        <div class="container footer-content">
            <p>&copy; 2026 Blog Jair Junior. Todos os direitos reservados.</p>
            <div class="footer-links">
                <a href="/sobre">Sobre</a>
                <a href="/contato">Contato</a>
            </div>
        </div>
    </footer>

    <script src="/js/main.js"></script>

</body>
</html>