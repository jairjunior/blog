<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contato | outOfBounds</title>
    <meta name="description" content="Entre em contato com Jair Junior, criador do outOfBounds, para envio de propostas profissionais, dúvidas técnicas, sugestões de pautas ou feedback sobre o site outOfBounds.">
    
    <!-- CSS principal do site e estilo específico de contato -->
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/contact.css">

    <!-- Importação da fonte Outfit do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@600;750;800&display=swap" rel="stylesheet">
</head>


<body>
    <!-- Cabeçalho Principal -->
    <%- include('partials/header', { currentUrl: currentUrl, user: user }) %>

    <main class="contact-container">

        <!-- Breadcrumb de Navegação -->
        <nav class="breadcrumb" aria-label="breadcrumb">
            <ol class="breadcrumb-list">
                <li class="breadcrumb-separator">/</li>
                <li class="breadcrumb-item">
                    <a href="/">Início</a>
                </li>

                <li class="breadcrumb-separator">/</li>

                <li class="breadcrumb-item">
                    Contato
                </li>
            </ol>
        </nav>

        <!-- Apresentação Inicial -->
        <header class="contact-header">
            <h1 class="contact-title">Fale comigo</h1>
            <p class="contact-text">
                Tem alguma dúvida, sugestão, proposta profissional ou encontrou algum erro no site?
            </p>
            <p class="contact-text">
                Preencha o formulário abaixo e entrarei em contato o mais breve possível.
            </p>
        </header>

        <!-- Formulário de Contato -->
        <section class="contact-form-section">
            <form id="contactForm" class="contact-form">
                
                <div class="form-group">
                    <label for="contactName">Nome: <span class="required">*</span></label>
                    <input 
                        type="text" 
                        id="contactName" 
                        name="name" 
                        maxlength="150" 
                        required 
                        placeholder="Nome e sobrenome" 
                        class="form-input"
                    >
                </div>

                <div class="form-group">
                    <label for="contactEmail">E-mail: <span class="required">*</span></label>
                    <input 
                        type="email" 
                        id="contactEmail" 
                        name="email" 
                        placeholder="seu.email@exemplo.com" 
                        class="form-input" 
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="subject">Assunto: <span class="required">*</span></label>
                    <select id="subject" name="subject" required class="form-input">
                        <option value="" disabled selected>Selecione o motivo do contato...</option>
                        <option value="Contato profissional">1) Contato profissional</option>
                        <option value="Contato social">2) Contato social</option>
                        <option value="Sugestão de tema para artigo">3) Sugestão de tema para artigo</option>
                        <option value="Dúvida sobre assuntos técnicos">4) Dúvida sobre assuntos técnicos</option>
                        <option value="Relatar erro de funcionamento do site">5) Relatar erro de funcionamento do site</option>
                        <option value="Relatar erro/equívoco no conteúdo dos artigos">6) Relatar erro/equívoco no conteúdo dos artigos</option>
                        <option value="Artigo desatualizado">7) Artigo desatualizado</option>
                        <option value="Outros">8) Outros</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="message">Mensagem: <span class="required">*</span></label>
                    <textarea 
                        id="message" 
                        name="message" 
                        rows="6" 
                        required 
                        placeholder="Escreva sua mensagem..." 
                        class="form-input"
                    ></textarea>
                </div>

                <button type="submit" id="contactSubmitBtn" class="btn-submit">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                    Enviar Mensagem
                </button>
            </form>
        </section>
    </main>

    <!-- Modal de Feedback (Sucesso / Erro) -->
    <div id="contactFeedbackModal" class="modal-overlay" aria-hidden="true">
        <div class="modal-card" role="dialog" aria-labelledby="modalMessage">
            <header class="modal-header">
                <div id="modalIcon" class="modal-icon"></div>
                <h2 id="modalTitle" class="modal-title"></h2>
            </header>
            <div class="modal-body">
                <p id="modalMessage" class="modal-message"></p>
            </div>
            <div class="modal-footer">
                <button type="button" id="modalActionBtn" class="modal-action-btn">Fechar</button>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <!-- Script de manipulação do formulário e do modal -->
    <script src="/js/main.js"></script>
    <script src="/js/contact.js"></script>

</body>
</html>