    <header class="site-header">
        <!-- Barra de navegação superior -->
        <div class="container header-top">
            <!-- Nome / Logomarca -->
            <h1 class="blog-title"><a href="/">jjOutOfBounds</a></h1>

            <!-- Conjunto de botões (Lupa, Login, Burger) -->
            <div class="top-menu-button-wrapper">
                <!-- Botão da Lupa  -->
                <button id="topSearchButton" title="Pesquisar">
                    <span id="searchIcon">&#x1F50D;</span>
                </button>

                <% if (user) { %>
                    <!-- Se o usuário estiver logado -->
                    <div class="user-profile-menu" id="userMenuContainer">
                        <!-- Foto de perfil redonda -->
                        <button class="profile-toggle-btn" id="profileToggleBtn" aria-label="Menu do usuário">
                            <% if (user.avatarUrl) { %>
                                <img src="/img/profiles/<%= user.avatarUrl %>" alt="Foto de perfil para <%= user.first_name %>" class="profile-avatar">
                            <% } else { %>
                                <div class="profile-avatar-fallback">
                                    <%= user.first_name ? user.first_name.charAt(0).toUpperCase() : 'U' %>
                                </div>
                            <% } %>
                        </button>

                        <!-- Menu Dropdown -->
                        <div class="profile-dropdown" id="profileDropdown">
                            <div class="dropdown-header">
                                <span class="dropdown-header-name"><%= user.first_name %> <%= user.last_name %></span>
                                <span class="dropdown-header-email"><%= user.email %></span>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="/conta/informacoes" class="dropdown-item">
                                <span class="dropdown-icon">⚙️</span>
                                <span>Informações da conta</span>
                            </a>
                            <a href="/conta/informacoes" class="dropdown-item">
                                <span class="dropdown-icon">⚙️</span>
                                <span>Informações da conta</span>
                            </a>
                            <a href="/conta/informacoes" class="dropdown-item">
                                <span class="dropdown-icon">⚙️</span>
                                <span>Informações da conta</span>
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="/api/auth/logout" class="dropdown-item logout-item">
                                <span class="dropdown-icon">🚪</span>
                                <span>Sair</span>
                            </a>
                        </div>
                    </div>
                <% } else { %>
                    <!-- Se NÃO estiver logado: Botão de Login com redirect -->
                    <!-- Botão de Login  -->
                    <a id="topLoginButton" href="/login?redirectTo=<%= encodeURIComponent(currentUrl || '/') %>" title="Entrar">
                        <svg id="loginIcon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                            <polyline points="10 17 15 12 10 7"></polyline>
                            <line x1="15" y1="12" x2="3" y2="12"></line>
                        </svg>
                        <span>Entrar</span>
                    </a>
                <% } %>
    
                <!-- Botão Hamburger (visível apenas em mobile) -->
                <button class="hamburger-btn" aria-label="Abrir Menu" aria-expanded="false" title="Menu principal">
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                    <span class="hamburger-bar"></span>
                </button>
            </div>


            <!-- Menu Principal (em mobile aparece na lateral) -->
            <nav class="top-navbar">
                <ul>
                    <!-- Links para Artigos, Sobre, Contato, Newsletter -->
                    <li>
                        <a href="/posts" class="top-navbar-link">
                            <svg class="top-navbar-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            </svg>
                            <span>Artigos</span>
                        </a>
                    </li>
                    <li>
                        <a href="/sobre" class="top-navbar-link">
                            <svg class="top-navbar-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="12" y1="16" x2="12" y2="12"></line>
                                <line x1="12" y1="8" x2="12.01" y2="8"></line>
                            </svg>
                            <span>Sobre</span>
                        </a>
                    </li>
                    <li>
                        <a href="/contato" class="top-navbar-link">
                            <svg class="top-navbar-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                <polyline points="22,6 12,13 2,6"></polyline>
                            </svg>
                            <span>Contato</span>
                        </a>
                    </li>
                    <li>
                        <a href="#" class="top-navbar-link">
                            <svg class="top-navbar-link-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 11a9 9 0 0 1 9 9"></path>
                                <path d="M4 4a16 16 0 0 1 16 16"></path>
                                <circle cx="5" cy="19" r="1"></circle>
                            </svg>
                            <span>Newsletter</span>
                        </a>
                    </li>
                    <!-- Botões de "Criar Conta" e "Entrar" (visível apenas em mobile) -->
                    <li class="mobile-menu-item">
                        <a class="btn-mobile-signup" href="/cadastrar?redirectTo=/" title="Criar Conta">
                            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="8.5" cy="7" r="4"></circle>
                                <line x1="20" y1="8" x2="20" y2="14"></line>
                                <line x1="23" y1="11" x2="17" y2="11"></line>
                            </svg>
                            Criar Conta
                        </a>
                    </li>
                    <li class="mobile-menu-item">
                        <a class="btn-mobile-login" href="/login?redirectTo=<%= encodeURIComponent(currentUrl || '/') %>" title="Entrar">
                            <svg class="btn-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                <polyline points="10 17 15 12 10 7"></polyline>
                                <line x1="15" y1="12" x2="3" y2="12"></line>
                            </svg>
                            Entrar
                        </a>
                    </li>
                    <!-- Barra de pesquisa do menu lateral (visível apenas em mobile) -->
                    <li class="mobile-menu-item search-menu-item">
                        <span>ou então:</span>
                        <form action="/search" method="GET" class="search-menu-form" id="menuSearchForm">
                            <div class="search-menu-wrapper">
                                <input 
                                    type="text" 
                                    name="q" 
                                    id="menuSearchInput" 
                                    class="search-menu-input" 
                                    placeholder="Pesquise aqui" 
                                    autocomplete="off"
                                    required
                                >
                            </div>
                        </form>
                    </li>

                </ul>
            </nav>
        </div>


        <!-- Modal de Busca Global -->
        <div class="search-modal-overlay" id="searchModal" aria-hidden="true">
            <div class="search-modal-container">
                <!-- Botão de Fechar o Modal -->
                <button class="search-close-btn" id="searchCloseBtn" aria-label="Fechar busca">&times;</button>

                <!-- Formulário e Campo de Pesquisa -->
                <h3>Buscar em todo o site:</h3>
                <form action="/search" method="GET" class="search-modal-form" id="searchModalForm">
                    <div class="search-input-wrapper">
                        <input 
                            type="text" 
                            name="q" 
                            id="searchModalInput" 
                            class="search-modal-input" 
                            placeholder="" 
                            autocomplete="off" 
                            required
                        >
                        <button type="submit" class="search-submit-btn" aria-label="Pesquisar">
                            <span class="search-submit-text">Buscar</span>
                            <svg class="search-submit-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>
                    </div>
                </form>

                <!-- Seção das Três Colunas Dinâmicas -->
                <div class="search-columns-grid">
                    <!-- Coluna 1: Mais Buscados -->
                    <div class="search-column">
                        <h3 class="search-col-title">Mais Buscados</h3>
                        <div class="search-pill-list">
                            <% if (locals.trendingSearches && trendingSearches.length > 0) { %>
                                <% trendingSearches.forEach(term => { %>
                                    <a href="/posts/busca?q=<%= encodeURIComponent(term) %>" class="search-pill"><%= term %></a>
                                <% }) %>
                            <% } else { %>
                                <span class="search-empty-text">Nenhuma busca popular no momento.</span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Coluna 2: Principais Tags -->
                    <div class="search-column">
                        <h3 class="search-col-title">Tags Populares</h3>
                        <div class="search-pill-list">
                            <% if (locals.popularTags && popularTags.length > 0) { %>
                                <% popularTags.forEach(tag => { %>
                                    <a href="/posts/tag/<%= tag.slug %>" class="search-pill tag-pill">#<%= tag.name %></a>
                                <% }) %>
                            <% } else { %>
                                <span class="search-empty-text">Em breve novas tags.</span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Coluna 3: Categorias -->
                    <div class="search-column">
                        <h3 class="search-col-title">Categorias</h3>
                        <ul class="search-category-list">
                            <% if (locals.siteCategories && siteCategories.length > 0) { %>
                                <% siteCategories.forEach(cat => { %>
                                    <li>
                                        <a href="/posts/<%= cat.slug %>" class="search-category-link"><%= cat.name %></a>
                                    </li>
                                <% }) %>
                            <% } else { %>
                                <li><a href="/posts/engenharia-de-software" class="search-category-link">Engenharia de Software</a></li>
                                <li><a href="/posts/inteligencia-artificial" class="search-category-link">Inteligência Artificial</a></li>
                                <li><a href="/posts/ciberseguranca" class="search-category-link">Cibersegurança</a></li>
                                <li><a href="/posts/cloud-devops" class="search-category-link">Cloud & DevOps</a></li>
                                <li><a href="/posts/noticias-tech" class="search-category-link">Notícias Tech</a></li>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>


        <!-- Menu Horizontal de Categorias -->
        <nav class="category-navbar container">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/posts/engenharia-de-software">Engenharia de Software</a></li>
                <li><a href="/posts/inteligencia-artificial">Inteligência Artificial</a></li>
                <li><a href="/posts/ciberseguranca">Cibersegurança</a></li>
                <li><a href="/posts/cloud-devops">Cloud & DevOps</a></li>
                <li><a href="/posts/noticias-tech">Notícias Tech</a></li>
            </ul>
        </nav>

    </header>