    <header class="site-header">
        <div class="container header-top">
            <h1 class="blog-title"><a href="/">jjOutOfBounds</a></h1>

            <!-- Botão Hamburger (Visível apenas em mobile) -->
            <button class="menu-toggle" aria-label="Abrir Menu" aria-expanded="false">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>

            <!-- Menu Superior -->
            <nav class="top-navbar">
                <ul>
                    <li><a href="#"><span class="buscar-text">Buscar</span> &#x1F50D;</a></li>
                    <li><a href="/posts">Artigos</a></li>
                    <li><a href="#">Sobre</a></li>
                    <li><a href="#">Contato</a></li>
                    <li><a href="#">Newsletter</a></li>
                    <li>
                        <% if (user) { %>
                            <!-- Se o usuário ESTIVER logado: Foto de perfil redonda + Menu Dropdown -->
                            <div class="user-profile-menu" id="userMenuContainer">
                                <button class="profile-toggle-btn" id="profileToggleBtn" aria-label="Menu do usuário">
                                    <% if (user.avatarUrl) { %>
                                        <img src="<%= user.avatarUrl %>" alt="Foto de perfil para <%= user.first_name %>" class="profile-avatar">
                                    <% } else { %>
                                        <div class="profile-avatar-fallback">
                                            <%= user.first_name ? user.first_name.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                    <% } %>
                                </button>

                                <!-- Menu Dropdown -->
                                <div class="profile-dropdown" id="profileDropdown">
                                    <div class="dropdown-header-email">
                                        <strong><%= user.email %></strong>
                                    </div>

                                    <div class="dropdown-divider"></div>

                                    <a href="/conta/informacoes" class="dropdown-item">
                                        <span class="dropdown-icon">⚙️</span>
                                        <span>Informações da conta</span>
                                    </a>

                                    <div class="dropdown-divider"></div>

                                    <a href="/api/auth/logout" class="dropdown-item logout-item">
                                        <span class="dropdown-icon">🚪</span>
                                        <span>Sair</span>
                                    </a>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- Se NÃO estiver logado: Botão de Login com redirect -->
                            <a href="/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>" class="btn-login">
                                <span>Entrar</span>
                                <svg class="login-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </a>
                        <% } %>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Menu Horizontal de Categorias -->
        <nav class="category-navbar container">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/posts/engenharia-de-software">Engenharia de Software</a></li>
                <li><a href="/posts/inteligencia-artificial">Inteligência Artificial</a></li>
                <li><a href="/posts/ciberseguranca">Cibersegurança</a></li>
                <li><a href="/posts/cloud-devops">Cloud & DevOps</a></li>
                <li><a href="/posts/noticias-tech">Notícias Tech</a></li>
            </ul>
        </nav>
    </header>