    <header class="site-header">
        <div class="container header-top">
            <h1 class="blog-title"><a href="/">jjOutOfBounds</a></h1>

            <!-- Botão Hamburger (Visível apenas em mobile) -->
            <button class="menu-toggle" aria-label="Abrir Menu" aria-expanded="false">
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
                <span class="hamburger-bar"></span>
            </button>

            <!-- Menu Superior -->
            <nav class="top-navbar">
                <ul>
                    <li>
                        <a href="#" id="searchLink" class="search-link">
                            <span class="search-text">Buscar</span> 
                            <span class="search-icon">&#x1F50D;</span>
                        </a></li>
                    <li><a href="/posts">Artigos</a></li>
                    <li><a href="#">Sobre</a></li>
                    <li><a href="#">Contato</a></li>
                    <li><a href="#">Newsletter</a></li>
                    <li>
                        <% if (user) { %>
                            <!-- Se o usuário ESTIVER logado: Foto de perfil redonda + Menu Dropdown -->
                            <div class="user-profile-menu" id="userMenuContainer">
                                <button class="profile-toggle-btn" id="profileToggleBtn" aria-label="Menu do usuário">
                                    <% if (user.avatarUrl) { %>
                                        <img src="<%= user.avatarUrl %>" alt="Foto de perfil para <%= user.first_name %>" class="profile-avatar">
                                    <% } else { %>
                                        <div class="profile-avatar-fallback">
                                            <%= user.first_name ? user.first_name.charAt(0).toUpperCase() : 'U' %>
                                        </div>
                                    <% } %>
                                </button>

                                <!-- Menu Dropdown -->
                                <div class="profile-dropdown" id="profileDropdown">
                                    <div class="dropdown-header-email">
                                        <strong><%= user.email %></strong>
                                    </div>

                                    <div class="dropdown-divider"></div>

                                    <a href="/conta/informacoes" class="dropdown-item">
                                        <span class="dropdown-icon">⚙️</span>
                                        <span>Informações da conta</span>
                                    </a>

                                    <div class="dropdown-divider"></div>

                                    <a href="/api/auth/logout" class="dropdown-item logout-item">
                                        <span class="dropdown-icon">🚪</span>
                                        <span>Sair</span>
                                    </a>
                                </div>
                            </div>
                        <% } else { %>
                            <!-- Se NÃO estiver logado: Botão de Login com redirect -->
                            <a href="/login?redirect=<%= encodeURIComponent(currentUrl || '/') %>" class="btn-login">
                                <span>Entrar</span>
                                <svg class="login-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </a>
                        <% } %>
                    </li>
                </ul>
            </nav>
        </div>

        <!-- Menu Horizontal de Categorias -->
        <nav class="category-navbar container">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/posts/engenharia-de-software">Engenharia de Software</a></li>
                <li><a href="/posts/inteligencia-artificial">Inteligência Artificial</a></li>
                <li><a href="/posts/ciberseguranca">Cibersegurança</a></li>
                <li><a href="/posts/cloud-devops">Cloud & DevOps</a></li>
                <li><a href="/posts/noticias-tech">Notícias Tech</a></li>
            </ul>
        </nav>


        <!-- Modal de Busca Global -->
        <div class="search-modal-overlay" id="searchModal" aria-hidden="true">
            <div class="search-modal-container">
                <!-- Botão de Fechar o Modal -->
                <button class="search-close-btn" id="searchCloseBtn" aria-label="Fechar busca">&times;</button>

                <!-- Formulário e Campo de Pesquisa -->
                <h3>Buscar em todo o site:</h3>
                <form action="/search" method="GET" class="search-modal-form" id="searchModalForm">
                    <div class="search-input-wrapper">
                        <input 
                            type="text" 
                            name="q" 
                            id="searchInput" 
                            class="search-modal-input" 
                            placeholder="" 
                            autocomplete="off" 
                            required
                        >
                        <button type="submit" class="search-submit-btn" aria-label="Pesquisar">
                            <span class="search-submit-text">Buscar</span>
                            <svg class="search-submit-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>
                    </div>
                </form>

                <!-- Seção das Três Colunas Dinâmicas -->
                <div class="search-columns-grid">
                    <!-- Coluna 1: Mais Buscados -->
                    <div class="search-column">
                        <h3 class="search-col-title">Mais Buscados</h3>
                        <div class="search-pill-list">
                            <% if (locals.trendingSearches && trendingSearches.length > 0) { %>
                                <% trendingSearches.forEach(term => { %>
                                    <a href="/posts/busca?q=<%= encodeURIComponent(term) %>" class="search-pill"><%= term %></a>
                                <% }) %>
                            <% } else { %>
                                <span class="search-empty-text">Nenhuma busca popular no momento.</span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Coluna 2: Principais Tags -->
                    <div class="search-column">
                        <h3 class="search-col-title">Tags Populares</h3>
                        <div class="search-pill-list">
                            <% if (locals.popularTags && popularTags.length > 0) { %>
                                <% popularTags.forEach(tag => { %>
                                    <a href="/posts/tag/<%= tag.slug %>" class="search-pill tag-pill">#<%= tag.name %></a>
                                <% }) %>
                            <% } else { %>
                                <span class="search-empty-text">Em breve novas tags.</span>
                            <% } %>
                        </div>
                    </div>

                    <!-- Coluna 3: Categorias -->
                    <div class="search-column">
                        <h3 class="search-col-title">Categorias</h3>
                        <ul class="search-category-list">
                            <% if (locals.siteCategories && siteCategories.length > 0) { %>
                                <% siteCategories.forEach(cat => { %>
                                    <li>
                                        <a href="/posts/<%= cat.slug %>" class="search-category-link"><%= cat.name %></a>
                                    </li>
                                <% }) %>
                            <% } else { %>
                                <li><a href="/posts/engenharia-de-software" class="search-category-link">Engenharia de Software</a></li>
                                <li><a href="/posts/inteligencia-artificial" class="search-category-link">Inteligência Artificial</a></li>
                                <li><a href="/posts/ciberseguranca" class="search-category-link">Cibersegurança</a></li>
                                <li><a href="/posts/cloud-devops" class="search-category-link">Cloud & DevOps</a></li>
                                <li><a href="/posts/noticias-tech" class="search-category-link">Notícias Tech</a></li>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

    </header>